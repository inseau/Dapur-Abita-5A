POSTGRES_USER=apsi
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=apsi_db
DATABASE_URL=postgresql://apsi:replace-with-a-local-only-password@localhost:5433/apsi_db?schema=public

# Neon: keep real connection strings in the ignored .env file or deployment secrets.
